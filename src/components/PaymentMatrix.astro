---
import MatrixValue from "@components/MatrixValue.astro";
import type { TransitSystem } from "@lib/schema";

interface Props {
  systems: TransitSystem[];
  type: "gate" | "tickets";
}

const { systems, type } = Astro.props;
const isGate = type === "gate";
---

<div class="table-wrap" data-matrix={type}>
  <table class={`matrix matrix-${type}`}>
    <thead>
      <tr>
        <th class="location-column">Country / Region</th>
        <th class="location-column">City / Area</th>
        <th class="system-column">Rail system</th>
        {
          isGate ? (
            <>
              <th>Transit card</th>
              <th>Contactless bank card</th>
              <th>Mobile wallet</th>
              <th>QR</th>
              <th>Official app</th>
              <th>Paper ticket or token</th>
              <th>Visitor pass</th>
            </>
          ) : (
            <>
              <th>Cash</th>
              <th>Bank card</th>
              <th>Contactless card</th>
              <th>Mobile wallet</th>
              <th>QR payment</th>
            </>
          )
        }
      </tr>
    </thead>
    <tbody>
      {systems.map((system) => (
        <tr
          data-system
          data-search={`${system.system} ${system.city} ${system.country}`.toLowerCase()}
          data-bank-card={system.payment.gate_entry.contactless_bank_card.status}
          data-mobile-wallet={system.payment.gate_entry.mobile_wallet.status}
          data-open-loop={system.interoperability.open_loop}
          data-ticket-cash={system.payment.ticket_machine.cash.status}
          data-ticket-bank-card={system.payment.ticket_machine.bank_card.status}
        >
          <td class="location-cell country-cell">
            <strong>{system.country}</strong>
            {system.region && <small>{system.region}</small>}
          </td>
          <td class="location-cell">
            <strong>{system.city}</strong>
          </td>
          <th class="system-cell" scope="row">
            <a href={`systems/${system.id}/`}>{system.system}</a>
            <small>{system.modes.join(" / ")}</small>
          </th>
          {
            isGate ? (
              <>
                <td><MatrixValue method={system.payment.gate_entry.local_transit_card} /></td>
                <td><MatrixValue method={system.payment.gate_entry.contactless_bank_card} /></td>
                <td><MatrixValue method={system.payment.gate_entry.mobile_wallet} /></td>
                <td><MatrixValue method={system.payment.gate_entry.qr_code} /></td>
                <td><MatrixValue method={system.payment.gate_entry.official_app} /></td>
                <td><MatrixValue method={system.payment.gate_entry.paper_or_token} /></td>
                <td><MatrixValue method={system.payment.gate_entry.tourist_pass} /></td>
              </>
            ) : (
              <>
                <td><MatrixValue method={system.payment.ticket_machine.cash} /></td>
                <td><MatrixValue method={system.payment.ticket_machine.bank_card} /></td>
                <td><MatrixValue method={system.payment.ticket_machine.contactless_card} /></td>
                <td><MatrixValue method={system.payment.ticket_machine.mobile_wallet} /></td>
                <td><MatrixValue method={system.payment.ticket_machine.qr_payment} /></td>
              </>
            )
          }
        </tr>
      ))}
    </tbody>
  </table>
</div>
