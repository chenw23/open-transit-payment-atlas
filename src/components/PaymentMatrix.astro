---
import MatrixValue from "@components/MatrixValue.astro";
import type { TransitSystem } from "@lib/schema";

interface Props {
  systems: TransitSystem[];
  type: "gate" | "tickets";
}

const { systems, type } = Astro.props;
const isGate = type === "gate";
---

<div class="table-wrap" data-matrix={type}>
  <table class={`matrix matrix-${type}`}>
    <thead>
      <tr>
        <th class="location-column">Country / Region</th>
        <th class="location-column">City / Area</th>
        <th class="system-column">Rail system</th>
        {
          isGate ? (
            <>
              <th>Fare card / ticket</th>
              <th>Contactless bank card</th>
              <th>QR / app ticket</th>
            </>
          ) : (
            <>
              <th>Cash</th>
              <th>Bank card</th>
              <th>Mobile / QR</th>
            </>
          )
        }
      </tr>
    </thead>
    <tbody>
      {systems.map((system) => (
        <tr
          data-system
          data-search={`${system.system} ${system.city} ${system.country}`.toLowerCase()}
          data-bank-card={system.payment.gate_entry.contactless_bank_card.status}
          data-mobile-wallet={system.payment.gate_entry.mobile_wallet.status}
          data-open-loop={system.interoperability.open_loop}
          data-ticket-cash={system.payment.ticket_machine.cash.status}
          data-ticket-bank-card={system.payment.ticket_machine.bank_card.status}
        >
          <td class="location-cell country-cell">
            <strong>{system.country}</strong>
            {system.region && <small>{system.region}</small>}
          </td>
          <td class="location-cell">
            <strong>{system.city}</strong>
          </td>
          <th class="system-cell" scope="row">
            <a href={`systems/${system.id}/`}>{system.system}</a>
            <small>{system.modes.join(" / ")}</small>
          </th>
          {
            isGate ? (
              <>
                <td>
                  <MatrixValue
                    items={[
                      { label: "Transit card", method: system.payment.gate_entry.local_transit_card },
                      { label: "Paper ticket or token", method: system.payment.gate_entry.paper_or_token },
                      { label: "Visitor pass", method: system.payment.gate_entry.tourist_pass },
                    ]}
                  />
                </td>
                <td>
                  <MatrixValue
                    items={[
                      { label: "Contactless bank card", method: system.payment.gate_entry.contactless_bank_card },
                    ]}
                  />
                </td>
                <td>
                  <MatrixValue
                    items={[
                      { label: "QR gate entry", method: system.payment.gate_entry.qr_code },
                      { label: "Official app", method: system.payment.gate_entry.official_app },
                    ]}
                  />
                </td>
              </>
            ) : (
              <>
                <td>
                  <MatrixValue
                    items={[
                      { label: "Cash", method: system.payment.ticket_machine.cash },
                    ]}
                  />
                </td>
                <td>
                  <MatrixValue
                    items={[
                      { label: "Bank card", method: system.payment.ticket_machine.bank_card },
                      { label: "Contactless card", method: system.payment.ticket_machine.contactless_card },
                    ]}
                  />
                </td>
                <td>
                  <MatrixValue
                    items={[
                      { label: "Mobile wallet", method: system.payment.ticket_machine.mobile_wallet },
                      { label: "QR payment", method: system.payment.ticket_machine.qr_payment },
                    ]}
                  />
                </td>
              </>
            )
          }
        </tr>
      ))}
    </tbody>
  </table>
</div>
