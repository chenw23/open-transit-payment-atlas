---
import { compactMethod } from "@lib/data";
import type { TransitSystem } from "@lib/schema";

interface Props {
  systems: TransitSystem[];
}

const { systems } = Astro.props;

function extraNotes(system: TransitSystem): string {
  const notes = [
    system.payment.gate_entry.contactless_bank_card.notes,
    system.payment.gate_entry.official_app.notes,
    system.payment.ticket_machine.contactless_card.notes,
    system.interoperability.notes,
  ].filter(Boolean);
  return notes.join(" ");
}
---

<div class="table-wrap">
  <table class="matrix">
    <thead>
      <tr>
        <th>System</th>
        <th>Opened</th>
        <th>Transit Card</th>
        <th>Bank Card</th>
        <th>Mobile Wallet</th>
        <th>QR</th>
        <th>Official App</th>
        <th>Tourist Pass</th>
        <th>TVM Cash</th>
        <th>TVM Card</th>
        <th>Open Loop</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      {systems.map((system) => (
        <tr>
          <th scope="row">
            <a href={`systems/${system.id}/`}>{system.system}</a>
            <small>{system.city} / {system.country}</small>
          </th>
          <td>{system.modes.join("/")}</td>
          <td>{compactMethod(system.payment.gate_entry.local_transit_card.status, system.payment.gate_entry.local_transit_card.methods)}</td>
          <td>{compactMethod(system.payment.gate_entry.contactless_bank_card.status, system.payment.gate_entry.contactless_bank_card.schemes)}</td>
          <td>{compactMethod(system.payment.gate_entry.mobile_wallet.status, system.payment.gate_entry.mobile_wallet.methods)}</td>
          <td>{compactMethod(system.payment.gate_entry.qr_code.status, system.payment.gate_entry.qr_code.methods)}</td>
          <td>{compactMethod(system.payment.gate_entry.official_app.status, system.payment.gate_entry.official_app.methods)}</td>
          <td>{compactMethod(system.payment.gate_entry.tourist_pass.status, system.payment.gate_entry.tourist_pass.methods)}</td>
          <td>{compactMethod(system.payment.ticket_machine.cash.status)}</td>
          <td>{compactMethod(system.payment.ticket_machine.bank_card.status, system.payment.ticket_machine.bank_card.schemes)}</td>
          <td>{compactMethod(system.interoperability.open_loop)}</td>
          <td class="notes">{extraNotes(system)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
