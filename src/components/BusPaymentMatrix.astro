---
import MatrixValue from "@components/MatrixValue.astro";
import type { BusSystem, PaymentStatus } from "@lib/schema";

interface Props {
  systems: BusSystem[];
}

const { systems } = Astro.props;

const exitLabels: Record<BusSystem["exit_validation"], string> = {
  required: "Required",
  not_required: "No",
  route_dependent: "Depends",
};

const statusPriority: PaymentStatus[] = [
  "yes",
  "partial",
  "planned",
  "unknown",
  "deprecated",
  "no",
];

const mobilePaymentStatus = (system: BusSystem) =>
  statusPriority.find((status) =>
    [
      system.payment.mobile_wallet,
      system.payment.qr_code,
      system.payment.official_app,
    ].some((method) => method.status === status),
  ) ?? "unknown";
---

<div class="table-wrap" data-matrix="bus">
  <table class="matrix matrix-bus">
    <thead>
      <tr>
        <th class="location-column">Country / Region</th>
        <th class="system-column">City / bus network</th>
        <th>Cash</th>
        <th>Transit card / ticket</th>
        <th>Bank card</th>
        <th>Mobile payment</th>
        <th>Tap off</th>
      </tr>
    </thead>
    <tbody>
      {systems.map((system) => (
        <tr
          data-system
          data-search={`${system.network} ${system.city} ${system.country}`.toLowerCase()}
          data-bank-card={system.payment.contactless_bank_card.status}
          data-mobile-payment={mobilePaymentStatus(system)}
          data-cash={system.payment.cash.status}
          data-tap-off={system.exit_validation}
        >
          <td class="location-cell country-cell">
            <strong>{system.country}</strong>
            {system.region && <small>{system.region}</small>}
          </td>
          <th class="system-cell" scope="row">
            <strong>{system.city}</strong>
            <a href={`systems/${system.id}/`}>{system.network}</a>
          </th>
          <td>
            <MatrixValue items={[{ label: "Cash", method: system.payment.cash }]} />
          </td>
          <td>
            <MatrixValue
              items={[
                { label: "Transit card", method: system.payment.transit_card },
                { label: "Paper ticket", method: system.payment.paper_ticket },
                { label: "Visitor pass", method: system.payment.tourist_pass },
              ]}
            />
          </td>
          <td>
            <MatrixValue
              items={[
                { label: "Contactless bank card", method: system.payment.contactless_bank_card },
              ]}
            />
          </td>
          <td>
            <MatrixValue
              items={[
                { label: "Mobile wallet or digital transit card", method: system.payment.mobile_wallet },
                { label: "QR code", method: system.payment.qr_code },
                { label: "Official app", method: system.payment.official_app },
              ]}
            />
          </td>
          <td>
            <span class={`validation-status validation-${system.exit_validation}`}>
              {exitLabels[system.exit_validation]}
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
