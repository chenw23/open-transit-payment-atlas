---
import PaymentMatrix from "@components/PaymentMatrix.astro";
import SeoHead from "@components/SeoHead.astro";
import { loadSystems } from "@lib/data";
import {
  HOME_DESCRIPTION,
  HOME_TITLE,
  siteUrl,
  systemModifiedDate,
} from "@lib/seo";

const systems = loadSystems();
const homePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const countries = new Set(systems.map((system) => system.country)).size;
const openLoop = systems.filter(
  (system) => system.interoperability.open_loop === "yes",
).length;
const contactlessGate = systems.filter(
  (system) => system.payment.gate_entry.contactless_bank_card.status === "yes",
).length;
const latestVerified = systems
  .map((system) => system.last_verified)
  .sort()
  .at(-1);
const latestModified = systems
  .map(systemModifiedDate)
  .sort()
  .at(-1);
const latestVerifiedLabel = latestVerified
  ? new Intl.DateTimeFormat("en", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(`${latestVerified}T00:00:00Z`))
  : "Not available";
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl("/").href}#website`,
      name: "Open Transit Payment Atlas",
      url: siteUrl("/").href,
      description: HOME_DESCRIPTION,
      inLanguage: "en",
    },
    {
      "@type": "Dataset",
      "@id": `${siteUrl("/").href}#dataset`,
      name: "Open Transit Payment Atlas",
      description: HOME_DESCRIPTION,
      url: siteUrl("/").href,
      inLanguage: "en",
      isAccessibleForFree: true,
      spatialCoverage: "Worldwide, excluding mainland China",
      dateModified: latestModified,
      keywords: [
        "rail transit payment methods",
        "metro payment methods",
        "contactless bank card",
        "mobile wallet",
        "ticket vending machine",
        "fare gate",
      ],
      distribution: [
        {
          "@type": "DataDownload",
          encodingFormat: "application/json",
          contentUrl: siteUrl("/data/systems.json").href,
        },
        {
          "@type": "DataDownload",
          encodingFormat: "text/csv",
          contentUrl: siteUrl("/data/systems.csv").href,
        },
      ],
    },
  ],
};

function joinValues(values: string[]): string {
  return values.length ? values.join(", ") : "not listed";
}
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={HOME_TITLE}
      description={HOME_DESCRIPTION}
      path="/"
      jsonLd={homeJsonLd}
    />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles.css`} />
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={homePath}>
          <span class="brand-mark" aria-hidden="true">T</span>
          <span>Open Transit Payment Atlas</span>
        </a>
        <nav>
          <a href="#passing-gate">Passing Gate</a>
          <a href="#tickets">Tickets</a>
          <a href="#legend">Legend</a>
          <a class="icon-link" href="https://github.com/chenw23/open-transit-payment-atlas" aria-label="GH: GitHub repository">
            GH
          </a>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <section class="intro-band">
        <div class="intro-copy">
          <p class="eyebrow">Rail transit payment reference</p>
          <h1>How can I pay for this metro?</h1>
          <p class="lede">
            Compare fare-gate and ticket-purchase payment methods across metro,
            urban rail, suburban rail, and airport rail systems outside mainland China.
          </p>
          <div class="intro-actions">
            <a class="button primary" href="#passing-gate">
              Check gate payment
            </a>
            <a class="button secondary" href="https://github.com/chenw23/open-transit-payment-atlas">
              View source
            </a>
          </div>
        </div>
        <dl class="summary-grid">
          <div>
            <dt>{systems.length}</dt>
            <dd>rail systems</dd>
          </div>
          <div>
            <dt>{countries}</dt>
            <dd>countries / regions</dd>
          </div>
          <div>
            <dt>{openLoop}</dt>
            <dd>network-wide bank-card tap-to-ride</dd>
          </div>
          <div>
            <dt>{contactlessGate}</dt>
            <dd>accept bank cards at gates</dd>
          </div>
        </dl>
      </section>

      <nav class="data-paths" aria-label="Payment data sections">
        <a href="#passing-gate">
          <span class="path-index">01</span>
          <span>
            <strong>Passing Gate</strong>
            <small>What can be tapped or scanned directly at the fare gate?</small>
          </span>
        </a>
        <a href="#tickets">
          <span class="path-index">02</span>
          <span>
            <strong>Tickets</strong>
            <small>What can be used to pay at a ticket vending machine?</small>
          </span>
        </a>
        <a href="#legend">
          <span class="path-index">03</span>
          <span>
            <strong>Status &amp; scope</strong>
            <small>Understand partial support, planned rollouts, and data limits.</small>
          </span>
        </a>
      </nav>

      <aside class="coverage-notice" aria-labelledby="mainland-china-coverage">
        <span class="coverage-code" aria-hidden="true">CN</span>
        <div>
          <h2 id="mainland-china-coverage">Looking for mainland China?</h2>
          <p>
            Mainland China records are not maintained in this atlas. See CNRT for
            city-by-city gate-entry and ticket-machine payment coverage.
          </p>
        </div>
        <a href="https://ivysauro.github.io/CNRT/data/Pay">
          View mainland China data ↗
        </a>
      </aside>

      <section id="matrix" class="matrix-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Rail transit payment reference</p>
            <h2>Browse payment methods</h2>
            <p class="section-summary">
              Sorted by Country / Region, then City / Area, then Rail System.
              Latest record verification: {latestVerifiedLabel}.
            </p>
          </div>
          <div class="export-links" id="data">
            <a href="data/systems.json">JSON ↗</a>
            <a href="data/systems.csv">CSV ↗</a>
            <a href="https://github.com/chenw23/open-transit-payment-atlas/blob/master/data/systems/core-sample.yaml">
              YAML ↗
            </a>
          </div>
        </div>

        <div class="matrix-toolbar">
          <label class="search-field">
            <span aria-hidden="true">⌕</span>
            <input id="matrix-search" type="search" placeholder="Filter by system, city, or country" />
          </label>
          <select id="payment-filter" aria-label="Filter payment support">
            <option value="all">All systems</option>
            <option value="bank-card">Contactless bank card at gate</option>
            <option value="open-loop">Network-wide bank-card tap-to-ride</option>
            <option value="mobile-wallet">Mobile wallet at gate</option>
            <option value="ticket-cash">Cash at ticket machine</option>
            <option value="ticket-bank-card">Bank card at ticket machine</option>
          </select>
        </div>

        <section id="passing-gate" class="matrix-block">
          <div class="matrix-heading">
            <div>
              <p class="eyebrow">Direct fare-gate entry</p>
              <h2>Passing Gate</h2>
            </div>
            <p>
              Payment media accepted directly at gates or validators. A bank card
              listed here can be tapped to travel without first buying a ticket.
            </p>
          </div>
          <PaymentMatrix systems={systems} type="gate" />
        </section>

        <section id="tickets" class="matrix-block">
          <div class="matrix-heading">
            <div>
              <p class="eyebrow">Ticket vending machines</p>
              <h2>Tickets</h2>
            </div>
            <p>
              Payment methods accepted when buying or reloading a fare product at
              a ticket machine. Staffed counters and online shops are not included.
            </p>
          </div>
          <PaymentMatrix systems={systems} type="tickets" />
        </section>
      </section>

      <section id="legend" class="reference-grid">
        <article class="reference-panel">
          <p class="eyebrow">How to read the tables</p>
          <h2>Scope</h2>
          <dl class="scope-list">
            <div>
              <dt>Passing Gate</dt>
              <dd>Use the card, device, app, or ticket directly at a gate or platform validator.</dd>
            </div>
            <div>
              <dt>Tickets</dt>
              <dd>Pay at a ticket vending machine before reaching the gate.</dd>
            </div>
            <div>
              <dt>Details</dt>
              <dd>Select a rail system to see named products, restrictions, sources, and verification dates.</dd>
            </div>
          </dl>
        </article>
        <article class="reference-panel">
          <p class="eyebrow">Status reference</p>
          <h2>Support states</h2>
          <dl class="status-list">
            <div><dt><span class="dot dot-yes"></span>Yes</dt><dd>Generally usable</dd></div>
            <div><dt><span class="dot dot-partial"></span>Partial</dt><dd>Limited rollout or conditions</dd></div>
            <div><dt><span class="dot dot-planned"></span>Planned</dt><dd>Officially announced</dd></div>
            <div><dt><span class="dot dot-no"></span>No</dt><dd>Not supported</dd></div>
            <div><dt><span class="dot dot-unknown"></span>Unknown</dt><dd>Not yet verified</dd></div>
            <div><dt><span class="dot dot-deprecated"></span>Deprecated</dt><dd>Being withdrawn or no longer accepted</dd></div>
          </dl>
        </article>
      </section>

      <section class="notes-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Named payment products</p>
            <h2>System notes</h2>
          </div>
        </div>
        <div class="notes-grid">
          {systems.map((system) => (
            <article>
              <a href={`systems/${system.id}/`}>{system.system}</a>
              <p>{system.city}, {system.country}</p>
              <dl>
                <div><dt>Transit card</dt><dd>{joinValues(system.payment.gate_entry.local_transit_card.methods)}</dd></div>
                <div><dt>Bank card</dt><dd>{joinValues(system.payment.gate_entry.contactless_bank_card.schemes)}</dd></div>
                <div><dt>Mobile wallet</dt><dd>{joinValues(system.payment.gate_entry.mobile_wallet.methods)}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section id="contribute" class="contribute-band">
        <div>
          <p class="eyebrow">Add or update a record</p>
          <h2>Help verify the next city</h2>
          <p>
            Add an official operator, transport authority, or payment-network source.
            Separate gate entry from ticket purchase and document partial rollouts.
          </p>
        </div>
        <a class="button primary" href="https://github.com/chenw23/open-transit-payment-atlas/blob/master/CONTRIBUTING.md">
          Contribution guide ↗
        </a>
      </section>
    </main>

    <script is:inline>
      const search = document.querySelector("#matrix-search");
      const filter = document.querySelector("#payment-filter");
      const rows = [...document.querySelectorAll(".matrix tbody tr[data-system]")];

      function applyFilters() {
        const query = search?.value.trim().toLowerCase() ?? "";
        const mode = filter?.value ?? "all";
        rows.forEach((row) => {
          const matchesQuery = row.dataset.search?.includes(query) ?? false;
          const matchesMode =
            mode === "all" ||
            (mode === "bank-card" && row.dataset.bankCard === "yes") ||
            (mode === "open-loop" && row.dataset.openLoop === "yes") ||
            (mode === "mobile-wallet" && row.dataset.mobileWallet === "yes") ||
            (mode === "ticket-cash" && row.dataset.ticketCash === "yes") ||
            (mode === "ticket-bank-card" && row.dataset.ticketBankCard === "yes");
          row.hidden = !(matchesQuery && matchesMode);
        });
      }

      search?.addEventListener("input", applyFilters);
      filter?.addEventListener("change", applyFilters);
    </script>
  </body>
</html>
