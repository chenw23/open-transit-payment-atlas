---
import PaymentMatrix from "@components/PaymentMatrix.astro";
import { loadSystems } from "@lib/data";

const systems = loadSystems();

function joinValues(values: string[]): string {
  return values.length ? values.join(", ") : "not listed";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="An evidence-backed atlas of rail transit payment methods around the world."
    />
    <title>Open Transit Payment Atlas</title>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles.css`} />
  </head>
  <body>
    <div class="wrapper">
      <aside class="sidebar">
        <h1><a href={import.meta.env.BASE_URL}>Open Transit Payment Atlas</a></h1>
        <p>Another view of rail transit payment.</p>
        <p class="view">
          <a href="https://github.com/chenw23/ICS1">View the Project on GitHub <small>chenw23/ICS1</small></a>
        </p>
        <nav class="side-nav">
          <a href="#legend">Legend</a>
          <a href="#passing">Passing Gate</a>
          <a href="#tickets">Tickets</a>
          <a href="#data">Data</a>
          <a href="#contribute">Contribute</a>
        </nav>
      </aside>

      <main>
        <h1>Rail Transit Payment Methods</h1>
        <p><code>Which payment methods can I actually use on this metro?</code></p>
        <p>
          A passenger-facing payment matrix for metro, urban rail, airport rail, and
          comparable rail transit systems outside mainland China. The project records
          gate entry, ticket purchase, cards, QR/app tickets, mobile wallets, and
          practical limitations with source-backed data.
        </p>

        <p class="links">
          <a href="data/systems.json">JSON</a> |
          <a href="data/systems.csv">CSV</a> |
          <a href="https://github.com/chenw23/ICS1/blob/master/data/systems/core-sample.yaml">Source YAML</a>
        </p>

        <h2>Content</h2>
        <ul>
          <li><a href="#legend">Legend</a></li>
          <li><a href="#passing">Passing Gate</a></li>
          <li><a href="#tickets">Tickets</a></li>
          <li><a href="#data">Data Exports</a></li>
          <li><a href="#contribute">Contribute</a></li>
        </ul>

        <h2 id="legend">Legend</h2>
        <table class="legend-table">
          <thead>
            <tr>
              <th>Mark</th>
              <th>Meaning</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>💳</td><td>Local or regional closed-loop transit card</td></tr>
            <tr><td>💳↗</td><td>Open-loop contactless bank card at fare gate</td></tr>
            <tr><td>📱</td><td>Mobile wallet or mobile transit card at fare gate</td></tr>
            <tr><td>QR</td><td>QR ticket or QR gate-entry product</td></tr>
            <tr><td>APP</td><td>Official app ticket or app-based gate entry</td></tr>
            <tr><td>🎫</td><td>Tourist pass or visitor product</td></tr>
            <tr><td>TVM</td><td>Ticket vending machine bank-card purchase/top-up</td></tr>
            <tr><td>OL</td><td>Open-loop tap-to-ride model</td></tr>
            <tr><td>✅</td><td>Fully supported / generally usable</td></tr>
            <tr><td>⭕</td><td>Limited support / selected channels, stations, products, or cards</td></tr>
            <tr><td>⏳</td><td>Officially announced or planned</td></tr>
            <tr><td>❌</td><td>Deprecated or discontinued</td></tr>
            <tr><td>?</td><td>Unknown or not yet verified</td></tr>
            <tr><td>V/M/AE/J</td><td>Visa / Mastercard / American Express / JCB</td></tr>
          </tbody>
        </table>

        <h2 id="passing">Passing Gate</h2>
        <PaymentMatrix systems={systems} />

        <h3>Notes</h3>
        <ol class="notes-list">
          {systems.map((system) => (
            <li>
              <strong>{system.system}</strong>:
              transit card {joinValues(system.payment.gate_entry.local_transit_card.methods)};
              bank card {joinValues(system.payment.gate_entry.contactless_bank_card.schemes)};
              mobile wallet {joinValues(system.payment.gate_entry.mobile_wallet.methods)}.
              {system.notes || system.interoperability.notes || "See system detail page for source-backed limitations."}
            </li>
          ))}
        </ol>

        <h2 id="tickets">Tickets</h2>
        <p>
          The current table includes a compact view of ticket vending machine cash and
          bank-card support. Detailed ticket machine fields are available in the JSON
          and CSV exports.
        </p>

        <h2 id="data">Data Exports</h2>
        <p>
          The YAML files under <code>data/systems/</code> are the source of truth. The
          website, JSON endpoint, and CSV endpoint are generated from the same validated
          records.
        </p>

        <h2 id="contribute">Contribute</h2>
        <ol>
          <li>Find the official fare, ticketing, or contactless-payment page.</li>
          <li>Separate gate entry from ticket purchase and ticket vending machines.</li>
          <li>Use explicit status values: yes, partial, planned, no, unknown, deprecated.</li>
          <li>Record limitations such as selected stations, selected gates, app-region locks, or local-card requirements.</li>
          <li>Run the validator before opening a pull request.</li>
        </ol>
      </main>
    </div>
  </body>
</html>
