---
import PaymentCell from "@components/PaymentCell.astro";
import SeoHead from "@components/SeoHead.astro";
import { loadSystems, statusLabels } from "@lib/data";
import {
  siteUrl,
  systemDescription,
  systemModifiedDate,
  systemTitle,
} from "@lib/seo";

export function getStaticPaths() {
  return loadSystems().map((system) => ({
    params: { id: system.id },
    props: { system },
  }));
}

const { system } = Astro.props;
const homePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const title = systemTitle(system);
const description = systemDescription(system);
const pageUrl = siteUrl(`/systems/${system.id}/`).href;
const detailJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      name: title,
      description,
      url: pageUrl,
      inLanguage: "en",
      dateModified: systemModifiedDate(system),
      citation: system.sources.map((source) => source.url),
      isPartOf: {
        "@id": `${siteUrl("/").href}#website`,
      },
      about: {
        "@type": "Service",
        name: system.system,
        serviceType: `${system.modes.join(", ")} public transport`,
        url: system.official_website,
        areaServed: {
          "@type": "City",
          name: system.city,
          containedInPlace: {
            "@type": "Country",
            name: system.country,
          },
        },
        provider: {
          "@type": "Organization",
          name: system.operator,
          url: system.official_website,
        },
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Payment atlas",
          item: siteUrl("/").href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: system.system,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      path={`/systems/${system.id}/`}
      imageAlt={`${system.system} payment methods in ${system.city}, ${system.country}`}
      jsonLd={detailJsonLd}
    />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles.css`} />
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={homePath}>
          <span class="brand-mark" aria-hidden="true">T</span>
          <span>Open Transit Payment Atlas</span>
        </a>
        <nav>
          <a href={`${homePath}#passing-gate`}>Passing Gate</a>
          <a href={system.official_website}>Official website</a>
          <a class="icon-link" href="https://github.com/chenw23/open-transit-payment-atlas" aria-label="GH: GitHub repository">
            GH
          </a>
        </nav>
      </div>
    </header>
    <main class="page-shell detail-page">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={homePath}>Payment atlas</a></li>
          <li aria-current="page"><span>{system.system}</span></li>
        </ol>
      </nav>
      <a class="back-link" href={`${homePath}#passing-gate`}>
        ← Back to payment tables
      </a>
      <section class="detail-intro">
        <div>
          <p class="eyebrow">{system.city}, {system.country}</p>
          <h1>{system.system}</h1>
          <p class="lede">
            Operated by {system.operator}. Last verified on {system.last_verified}.
          </p>
          <a class="button secondary" href={system.official_website}>
            Official website ↗
          </a>
        </div>
        <dl class="detail-summary">
          <div>
            <dt>{statusLabels[system.payment.gate_entry.contactless_bank_card.status]}</dt>
            <dd>bank card at gate</dd>
          </div>
          <div>
            <dt>{statusLabels[system.interoperability.open_loop]}</dt>
            <dd>open-loop payment</dd>
          </div>
        </dl>
      </section>

      <section class="detail-grid">
        <article class="detail-panel">
          <p class="eyebrow">Passenger access</p>
          <h2>Gate entry</h2>
          <PaymentCell label="Transit card" method={system.payment.gate_entry.local_transit_card} system={system} />
          <PaymentCell label="Contactless bank card" method={system.payment.gate_entry.contactless_bank_card} system={system} />
          <PaymentCell label="Mobile wallet" method={system.payment.gate_entry.mobile_wallet} system={system} />
          <PaymentCell label="QR gate entry" method={system.payment.gate_entry.qr_code} system={system} />
          <PaymentCell label="Official app" method={system.payment.gate_entry.official_app} system={system} />
          <PaymentCell label="Paper ticket or token" method={system.payment.gate_entry.paper_or_token} system={system} />
          <PaymentCell label="Visitor pass" method={system.payment.gate_entry.tourist_pass} system={system} />
        </article>
        <article class="detail-panel">
          <p class="eyebrow">Purchase and top-up</p>
          <h2>Ticket purchase</h2>
          <PaymentCell label="Cash" method={system.payment.ticket_machine.cash} system={system} />
          <PaymentCell label="Bank card" method={system.payment.ticket_machine.bank_card} system={system} />
          <PaymentCell label="Contactless card" method={system.payment.ticket_machine.contactless_card} system={system} />
          <PaymentCell label="Mobile wallet" method={system.payment.ticket_machine.mobile_wallet} system={system} />
          <PaymentCell label="QR payment" method={system.payment.ticket_machine.qr_payment} system={system} />
        </article>
        <article class="detail-panel">
          <p class="eyebrow">Evidence</p>
          <h2>Sources</h2>
          <ul class="source-list">
            {system.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>
                <small>Accessed {source.accessed}</small>
              </li>
            ))}
          </ul>
          {system.notes && <p>{system.notes}</p>}
        </article>
      </section>
    </main>
  </body>
</html>
